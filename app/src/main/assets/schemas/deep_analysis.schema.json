{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/deep_analysis.schema.json",
  "title": "DeepAnalysis",
  "description": "Cloud (Gemini) deep analysis of a redacted message. Validated before it is shown or its action offered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "riskLevel",
    "category",
    "confidence",
    "summary",
    "tactics",
    "whatToDo",
    "method"
  ],
  "properties": {
    "riskLevel": {
      "enum": [
        "SAFE",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "category": {
      "enum": [
        "NONE",
        "PHISHING_LINK",
        "IMPERSONATION",
        "PACKAGE_DELIVERY",
        "BANK_FRAUD",
        "TOLL_OR_FINE",
        "PRIZE_OR_LOTTERY",
        "JOB_OFFER",
        "ROMANCE_OR_WRONG_NUMBER",
        "CRYPTO_INVESTMENT",
        "TECH_SUPPORT",
        "OTP_THEFT",
        "ROBOCALL",
        "SPOOFED_CALLER",
        "OTHER"
      ]
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "tactics": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "whatToDo": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "method": {
      "enum": [
        "NONE",
        "BLOCK_NUMBER",
        "ALLOW_NUMBER",
        "REJECT_CALL",
        "QUARANTINE_SMS",
        "REPORT_SCAM",
        "SAVE_CONTACT"
      ],
      "description": "The ONE registry method the model proposes (alias, upper-case). It is validated against the registry and the method's input schema before dispatch."
    }
  }
}