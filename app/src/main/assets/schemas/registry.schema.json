{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/registry.schema.json",
  "title": "MethodRegistry",
  "description": "Versioned registry of every typed method a model (or the user) may invoke.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryVersion",
    "methods"
  ],
  "properties": {
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/MethodSpec"
      }
    }
  },
  "definitions": {
    "MethodSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "alias",
        "version",
        "title",
        "capability",
        "execution",
        "channels",
        "minRisk",
        "autoApply",
        "contactSafe",
        "input",
        "output"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^guardian\\.[a-z]+\\.[a-z]+@v[0-9]+$"
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "capability": {
          "type": "string",
          "enum": [
            "telephony.block",
            "telephony.allow",
            "telephony.screen",
            "sms.quarantine",
            "report.external",
            "contacts.write",
            "net.cloud_ai"
          ]
        },
        "execution": {
          "type": "string",
          "enum": [
            "device",
            "cloud"
          ]
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CALL",
              "SMS"
            ]
          },
          "minItems": 1
        },
        "minRisk": {
          "type": "string",
          "enum": [
            "SAFE",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "maxRisk": {
          "type": "string",
          "enum": [
            "SAFE",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "minConfidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "autoApply": {
          "type": "boolean",
          "description": "May run without a tap when proposed by rules or the on-device model."
        },
        "contactSafe": {
          "type": "boolean",
          "description": "False = must never run against a saved contact or trusted sender."
        },
        "requiresConsent": {
          "type": "boolean"
        },
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      }
    }
  }
}