{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/methods/guardian.contact.save.v1.output.json",
  "title": "SaveContactOutput",
  "description": "Result of guardian.contact.save@v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "editorOpened"
  ],
  "properties": {
    "number": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^(\\+?[0-9]{3,20}|[^\\s@]+@[^\\s@]+)$",
      "description": "Normalized sender (digits with optional +, or an email-to-SMS address). Bound from the screened event, never from model text.",
      "title": "Sender",
      "format": "phone"
    },
    "editorOpened": {
      "type": "boolean",
      "title": "Contact editor opened"
    }
  }
}
