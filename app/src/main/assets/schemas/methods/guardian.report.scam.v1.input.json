{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/methods/guardian.report.scam.v1.input.json",
  "title": "ReportScamInput",
  "description": "Prepare a spam report (forward to 7726 / carrier spam reporting). The user sends it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "channel",
    "category",
    "reason"
  ],
  "properties": {
    "eventId": {
      "type": "integer",
      "minimum": 1,
      "description": "Screening event id. Bound from the trusted context.",
      "title": "Screening event",
      "readOnly": true
    },
    "channel": {
      "type": "string",
      "enum": [
        "CALL",
        "SMS"
      ],
      "title": "Channel"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "title": "Scam type"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short justification, shown to the user and stored in the receipt.",
      "title": "Reason"
    }
  }
}
