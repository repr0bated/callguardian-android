{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/methods/guardian.call.block.v1.output.json",
  "title": "BlockNumberOutput",
  "description": "Result of guardian.call.block@v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "scope",
    "previouslyBlocked",
    "blockedAt"
  ],
  "properties": {
    "number": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^(\\+?[0-9]{3,20}|[^\\s@]+@[^\\s@]+)$",
      "description": "Normalized sender (digits with optional +, or an email-to-SMS address). Bound from the screened event, never from model text.",
      "title": "Sender",
      "format": "phone"
    },
    "scope": {
      "type": "string",
      "enum": [
        "CALLS",
        "MESSAGES",
        "ALL"
      ],
      "title": "Block"
    },
    "previouslyBlocked": {
      "type": "boolean",
      "title": "Was already blocked"
    },
    "blockedAt": {
      "type": "integer",
      "minimum": 0,
      "title": "Blocked at",
      "format": "epoch-millis"
    }
  }
}
