{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/repr0bated/callguardian-android/schemas/methods/guardian.sms.quarantine.v1.output.json",
  "title": "QuarantineSmsOutput",
  "description": "Result of guardian.sms.quarantine@v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "quarantined",
    "warningPosted"
  ],
  "properties": {
    "eventId": {
      "type": "integer",
      "minimum": 1,
      "description": "Screening event id. Bound from the trusted context.",
      "title": "Screening event"
    },
    "quarantined": {
      "type": "boolean",
      "title": "Quarantined"
    },
    "warningPosted": {
      "type": "boolean",
      "title": "Warning posted"
    }
  }
}
